#!/usr/bin/env bash
# Create a single-purpose disposable Kubernetes cluster and launch real IoT Pods.
# Never reconfigure an existing cluster or overwrite a production namespace.
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
CLUSTER="${IOT_KIND_CLUSTER:-iot-analytics}"
NAMESPACE="${IOT_KIND_NAMESPACE:-iot-validation}"
NODE_IMAGE="kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a"

for command in docker kind kubectl helm openssl; do
  command -v "$command" >/dev/null || { echo "Missing $command" >&2; exit 1; }
done
docker info >/dev/null
if kind get clusters | grep -Fxq "$CLUSTER"; then
  echo "Cluster $CLUSTER already exists; refusing to modify it" >&2
  exit 1
fi
kind create cluster --name "$CLUSTER" --image "$NODE_IMAGE" --wait 180s
kubectl config use-context "kind-$CLUSTER" >/dev/null
[[ "$(kubectl config current-context)" == "kind-$CLUSTER" ]] || exit 1
kubectl create namespace "$NAMESPACE"

password="$(openssl rand -hex 32)"
kubectl -n "$NAMESPACE" create secret generic iot-central-secret \
  --from-literal=timescaledb_db=iot \
  --from-literal=timescaledb_user=iot \
  --from-literal="timescaledb_password=$password"
unset password
kubectl -n "$NAMESPACE" create configmap iot-schema \
  --from-file="schema.sql=$ROOT/services/schema.sql"
kubectl -n "$NAMESPACE" apply -f "$ROOT/infra/kind/dependencies.yaml"

echo "Waiting for the real TimescaleDB and KRaft Kafka Pods..."
kubectl -n "$NAMESPACE" rollout status deployment/timescaledb --timeout=300s
kubectl -n "$NAMESPACE" rollout status deployment/kafka --timeout=300s

for name in ingestion device-registry; do
  docker build -t "iot/$name:kind" "$ROOT/services/$name"
  kind load docker-image "iot/$name:kind" --name "$CLUSTER"
done
for name in telemetry-worker stream-worker alert-worker kpi-job; do
  docker build -t "iot/$name:kind" -f "$ROOT/services/workers/$name/Dockerfile" "$ROOT/services/workers"
  kind load docker-image "iot/$name:kind" --name "$CLUSTER"
done

helm dependency build "$ROOT/iot-helm"
helm upgrade --install iot-analytics "$ROOT/iot-helm" \
  --namespace "$NAMESPACE" \
  --set infra.enabled=false --set monitoring.enabled=false \
  --set apps.imageMode=kind --wait --timeout 10m

echo "PASS: disposable Kubernetes runtime has all five long-running IoT apps"
