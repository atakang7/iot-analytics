#!/usr/bin/env bash
# Protected, non-overwriting logical backup. It never changes the live database.
set -Eeuo pipefail
umask 077
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
destination="$1"
[[ -n "$destination" && "$destination" == /* ]] || { echo "Usage: backup /absolute/path/outside/repo.dump" >&2; exit 2; }
[[ -d "$(dirname "$destination")" ]] || { echo "Backup parent directory missing" >&2; exit 2; }
[[ "$destination" != "$ROOT"/* ]] || { echo "Keep backups outside the Git repository" >&2; exit 2; }
[[ ! -e "$destination" && ! -L "$destination" ]] || { echo "Refusing overwrite: $destination" >&2; exit 2; }
[[ ! -e "$destination.sha256" && ! -L "$destination.sha256" ]] || { echo "Refusing overwrite: $destination.sha256" >&2; exit 2; }
temporary="$(mktemp "$(dirname "$destination")/.iot-backup-XXXXXXXX")"
checksum="$(mktemp "$(dirname "$destination")/.iot-sha-XXXXXXXX")"
trap 'rm -f "$temporary" "$checksum"' EXIT
docker compose -f "$ROOT/services/docker-compose.yml" exec -T timescaledb \
  pg_dump -U iot -d iot --format=custom --no-owner --no-acl >"$temporary"
test -s "$temporary"
sha256sum "$temporary" | cut -d ' ' -f1 > "$checksum"
# Exclusive hard links do not follow or clobber a preexisting destination.
ln "$temporary" "$destination"
ln "$checksum" "$destination.sha256"
echo "PASS: protected logical backup $destination"
