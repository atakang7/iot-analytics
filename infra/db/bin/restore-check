#!/usr/bin/env bash
# Rehearse a complete TimescaleDB restore in a new disposable database.
set -Eeuo pipefail
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
archive="$1"
[[ -n "$archive" && "$archive" == /* && -s "$archive" ]] || {
  echo "Usage: restore-check /absolute/path/backup.dump" >&2; exit 2;
}
if [[ -f "$archive.sha256" ]]; then
  expected="$(cat "$archive.sha256")"
  actual="$(sha256sum "$archive" | cut -d ' ' -f1)"
  [[ "$expected" == "$actual" ]] || { echo "Backup checksum mismatch" >&2; exit 1; }
fi
name="iot_restore_$(date +%s)_$RANDOM"
[[ "$name" =~ ^iot_restore_[0-9]+_[0-9]+$ ]] || exit 1
created=false
cleanup() {
  if [[ "$created" == true ]]; then
    docker compose -f "$ROOT/services/docker-compose.yml" exec -T timescaledb \
      dropdb -U iot --if-exists --force "$name" >/dev/null || true
  fi
}
trap cleanup EXIT
docker compose -f "$ROOT/services/docker-compose.yml" exec -T timescaledb createdb -U iot "$name"
created=true
docker compose -f "$ROOT/services/docker-compose.yml" exec -T timescaledb \
  psql -U iot -d "$name" -v ON_ERROR_STOP=1 -c 'CREATE EXTENSION IF NOT EXISTS timescaledb;' >/dev/null
docker compose -f "$ROOT/services/docker-compose.yml" exec -T timescaledb \
  psql -U iot -d "$name" -v ON_ERROR_STOP=1 -c 'SELECT timescaledb_pre_restore();' >/dev/null
docker compose -f "$ROOT/services/docker-compose.yml" exec -T timescaledb \
  pg_restore -U iot -d "$name" -F c --no-owner --no-acl --exit-on-error < "$archive"
docker compose -f "$ROOT/services/docker-compose.yml" exec -T timescaledb \
  psql -U iot -d "$name" -v ON_ERROR_STOP=1 -c 'SELECT timescaledb_post_restore();' >/dev/null
docker compose -f "$ROOT/services/docker-compose.yml" exec -T timescaledb \
  psql -U iot -d "$name" -v ON_ERROR_STOP=1 <<'SQL'
DO $$
BEGIN
  IF (SELECT COUNT(*) FROM telemetry WHERE device_id = 'ci-recovery') <> 1
     OR (SELECT COUNT(*) FROM alerts WHERE alert_id = 'ci-recovery-alert') <> 1
     OR NOT EXISTS (SELECT 1 FROM timescaledb_information.hypertables WHERE hypertable_name = 'telemetry')
     OR NOT EXISTS (SELECT 1 FROM timescaledb_information.hypertables WHERE hypertable_name = 'kpis')
     OR NOT EXISTS (SELECT 1 FROM pg_indexes WHERE indexname = 'idx_telemetry_identity')
     OR NOT EXISTS (SELECT 1 FROM pg_indexes WHERE indexname = 'idx_kpis_window')
  THEN RAISE EXCEPTION 'Backup does not restore critical data, hypertables or indexes';
  END IF;
END $$;
SQL
echo "PASS: restored TimescaleDB rows, hypertables and unique indexes"
