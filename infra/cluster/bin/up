#!/usr/bin/env bash
# Provision a dedicated three-node Kubernetes foundation, never an existing cluster.
set -Eeuo pipefail
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
CLUSTER="iot-foundation"
IMAGE="kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a"
for cmd in docker kind kubectl; do command -v "$cmd" >/dev/null || exit 1; done
docker info >/dev/null
if kind get clusters | grep -Fxq "$CLUSTER"; then
  echo "Refusing to mutate the existing cluster $CLUSTER" >&2; exit 1
fi
kind create cluster --name "$CLUSTER" --config "$ROOT/infra/cluster/kind.yaml" \
  --image "$IMAGE" --wait 240s
[[ "$(kubectl config current-context)" == "kind-$CLUSTER" ]] || exit 1
# Kind's --wait can return before both new workers join and become Ready.
kubectl wait --for=condition=Ready nodes --all --timeout=240s
kubectl -n kube-system rollout status deployment/coredns --timeout=180s
kubectl -n local-path-storage rollout status deployment/local-path-provisioner --timeout=180s
kubectl create namespace iot-admission-proof
kubectl label namespace iot-admission-proof iot-policy=enforce
kubectl apply -f "$ROOT/policies/admission.yaml"
echo "PASS: private control plane and two worker nodes have been provisioned"
