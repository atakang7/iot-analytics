#!/usr/bin/env bash
# Publish one exact Trivy-scanned OCI archive and keyless-sign the immutable digest.
set -Eeuo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
source "$ROOT/delivery/lib/oci.sh"

service="$1"
test -n "$service"
: "$GITHUB_SHA" "$GITHUB_REPOSITORY" "$REGISTRY_TOKEN" "$REGISTRY_USER"
: "$RUNNER_TEMP" "$GITHUB_WORKSPACE" "$GITHUB_REF"
[[ "$GITHUB_REF" == "refs/heads/main" && "$GITHUB_SHA" =~ ^[a-f0-9]{40}$ ]] || {
  echo "Only the verified main commit may publish" >&2; exit 1;
}
cd "$GITHUB_WORKSPACE"
output="$RUNNER_TEMP/iot-publish"
mkdir -p "$output"
archive="$output/$service.oci.tar"
oci_build "$service" "$archive"
oci_scan "$archive" "$output/$service.sbom.json"

lower_repo="$(printf '%s' "$GITHUB_REPOSITORY" | tr '[:upper:]' '[:lower:]')"
image="ghcr.io/$lower_repo/$service"
printf '%s' "$REGISTRY_TOKEN" | skopeo login ghcr.io \
  --username "$REGISTRY_USER" --password-stdin >/dev/null
oci_copy "$archive" "$image" "sha-$GITHUB_SHA" "$output/$service.digest" secure
digest="$(cat "$output/$service.digest")"
oci_verify "$archive" "$image" "$digest" secure

ref="$image@$digest"
identity="https://github.com/$GITHUB_REPOSITORY/.github/workflows/publish.yaml@refs/heads/main"
cosign sign --yes "$ref"
cosign verify --certificate-identity "$identity" \
  --certificate-oidc-issuer https://token.actions.githubusercontent.com "$ref" >/dev/null

python3 - "$service" "$GITHUB_SHA" "$ref" "$output/$service.identity.json" <<'PY'
import json, sys
from pathlib import Path
service, commit, image, output = sys.argv[1:]
Path(output).write_text(json.dumps({
    "commit": commit, "service": service, "image": image,
}, sort_keys=True) + "\n")
PY
echo "PASS: published scanned and signed $ref"
