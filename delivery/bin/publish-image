#!/usr/bin/env bash
# Publish exactly the OCI bytes scanned by Trivy, then keyless-sign their digest.
# Called only by .github/workflows/publish.yaml on the verified main commit.
set -Eeuo pipefail

service="${1:?usage: publish-image SERVICE}"
case "$service" in
  ingestion|device-registry|telemetry-worker|stream-worker|alert-worker|kpi-job) ;;
  *) echo "Unknown service: $service" >&2; exit 2 ;;
esac

: "${GITHUB_SHA:?Missing release commit}"
: "${GITHUB_REPOSITORY:?Missing repository identity}"
: "${REGISTRY_TOKEN:?Missing registry token}"
: "${REGISTRY_USER:?Missing registry user}"
: "${RUNNER_TEMP:?Missing runner temporary directory}"
: "${GITHUB_WORKSPACE:?Missing repository checkout}"
[[ "$GITHUB_REF" == "refs/heads/main" ]] || { echo "Only main can publish" >&2; exit 1; }
[[ "$GITHUB_SHA" =~ ^[0-9a-f]{40}$ ]] || { echo "Invalid source SHA" >&2; exit 1; }

cd "$GITHUB_WORKSPACE"
if [[ "$service" == "ingestion" || "$service" == "device-registry" ]]; then
  context="services/$service"
  dockerfile="services/$service/Dockerfile"
else
  context="services/workers"
  dockerfile="services/workers/$service/Dockerfile"
fi

output="$RUNNER_TEMP/iot-publish"
mkdir -p "$output"
archive="$output/$service.oci.tar"
layout="$output/$service-layout"
mkdir -p "$layout"

# The detached OCI archive is the only artifact that can be published.
docker buildx build --platform linux/amd64 --provenance=false --sbom=false \
  --label "org.opencontainers.image.revision=$GITHUB_SHA" \
  --file "$dockerfile" --output "type=oci,dest=$archive" "$context"
tar -xf "$archive" -C "$layout"

# Security check and SBOM both inspect the artifact BEFORE publication.
trivy image --input "$layout" --scanners vuln \
  --severity CRITICAL --exit-code 1
trivy image --input "$layout" --format cyclonedx \
  --output "$output/$service.sbom.json"

image="ghcr.io/${GITHUB_REPOSITORY,,}/$service"
tag="sha-$GITHUB_SHA"
printf '%s' "$REGISTRY_TOKEN" | skopeo login ghcr.io \
  --username "$REGISTRY_USER" --password-stdin >/dev/null

source_digest="sha256:$(skopeo inspect --raw "oci-archive:$archive" | sha256sum | cut -d' ' -f1)"
skopeo copy --all --preserve-digests \
  --digestfile "$output/$service.digest" \
  "oci-archive:$archive" "docker://$image:$tag"
digest="$(cat "$output/$service.digest")"
[[ "$digest" == "$source_digest" ]] || {
  echo "Registry digest differs from scanned OCI manifest" >&2; exit 1;
}
remote_digest="sha256:$(skopeo inspect --raw "docker://$image@$digest" | sha256sum | cut -d' ' -f1)"
[[ "$remote_digest" == "$digest" ]] || {
  echo "Published registry manifest failed digest verification" >&2; exit 1;
}

# GitHub OIDC identity is tied to the trusted main-branch publishing workflow.
ref="$image@$digest"
identity="https://github.com/$GITHUB_REPOSITORY/.github/workflows/publish.yaml@refs/heads/main"
cosign sign --yes "$ref"
cosign verify --certificate-identity "$identity" \
  --certificate-oidc-issuer https://token.actions.githubusercontent.com "$ref" >/dev/null

python3 - "$service" "$GITHUB_SHA" "$ref" "$output/$service.identity.json" <<'PY'
import json
import sys
from pathlib import Path
service, commit, image, output = sys.argv[1:]
Path(output).write_text(json.dumps({
    "commit": commit, "service": service, "image": image,
}, sort_keys=True) + "\n")
PY
echo "Published, scanned and signed $ref"
