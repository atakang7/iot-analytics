#!/usr/bin/env bash
# Test the real publishing primitives without GHCR credentials or network writes.
set -Eeuo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
source "$ROOT/delivery/lib/oci.sh"
cd "$ROOT"

: "$GITHUB_SHA"
work="$(mktemp -d)"
registry="iot-local-registry-$RANDOM"
cleanup() {
  docker rm -f "$registry" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT
docker run -d --name "$registry" \
  -p 127.0.0.1:5001:5000 registry:2.8.3 >/dev/null

ready=false
for attempt in $(seq 1 60); do
  if curl -fsS http://127.0.0.1:5001/v2/ >/dev/null 2>&1; then
    ready=true
    break
  fi
  sleep 2
done
[[ "$ready" == true ]] || { echo "Local registry failed to start" >&2; exit 1; }

archive="$work/alert-worker.oci.tar"
image="localhost:5001/iot/alert-worker"
oci_build alert-worker "$archive"
oci_scan "$archive" "$work/alert-worker.sbom.json"
oci_copy "$archive" "$image" "sha-$GITHUB_SHA" "$work/published.digest" local
digest="$(cat "$work/published.digest")"
oci_verify "$archive" "$image" "$digest" local
echo "PASS: scanned exact OCI bytes reached the registry unchanged"

# Local-only signing uses a freshly generated short-lived key, NEVER CI secrets.
export COSIGN_PASSWORD=""
cosign generate-key-pair --output-key-prefix "$work/trusted"
cosign sign --yes --key "$work/trusted.key" \
  --allow-http-registry --tlog-upload=false "$image@$digest"
cosign verify --key "$work/trusted.pub" \
  --allow-http-registry --insecure-ignore-tlog "$image@$digest" >/dev/null

cosign generate-key-pair --output-key-prefix "$work/untrusted"
if cosign verify --key "$work/untrusted.pub" \
     --allow-http-registry --insecure-ignore-tlog "$image@$digest" >/dev/null 2>&1; then
  echo "Invalid signing key was accepted" >&2
  exit 1
fi
echo "PASS: Cosign validates the correct identity and rejects an unrelated key"
